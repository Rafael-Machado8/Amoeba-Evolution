{
  "name": "amoeba-evolution",
  "version": "0.4.0",
  "description": "Um jogo de fusão e descoberta, da primeira célula ao cosmos.",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "balance": "node scripts/balance.cjs",
    "build": "node scripts/build.cjs",
    "desktop": "npm run build && electron .",
    "package:windows": "npm run build && node scripts/package-desktop.cjs",
    "android:init": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electron/packager": "20.3.0",
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.3.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
